# FinAlly environment configuration.
# Copy to .env (gitignored) and fill in values. Never commit real keys.

# Required for AI chat (not needed when LLM_MOCK=true).
ANTHROPIC_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in market simulator (recommended).
MASSIVE_API_KEY=

# Optional: "true" returns deterministic mock LLM responses (tests, CI, no key).
LLM_MOCK=false
